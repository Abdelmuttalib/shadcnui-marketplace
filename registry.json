      "files": [
        {
          "path": "registry/carbon/ui/button.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/carbon/ui/select.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/carbon/ui/typography.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/carbon/ui/checkbox.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "font-sans": "Inter, sans-serif"
        },
        "light": {
          "background": "100% 0 0",
